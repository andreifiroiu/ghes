APP_NAME=EventPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://eventpulse.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ghes
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="events@eventpulse.app"
MAIL_FROM_NAME="EventPulse"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

GEOCODING_PROVIDER=nominatim
GOOGLE_GEOCODING_KEY=

# Google OAuth sign-in. Redirect URI must match the one registered in the
# Google Cloud console exactly; the route is auth/{provider}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

EVENTPULSE_CITY=Bucharest
EVENTPULSE_DEFAULT_CITY=timisoara
EVENTPULSE_SCRAPE_INTERVAL_HOURS=4
EVENTPULSE_NOTIFICATION_HOUR=8
# Set to false to stop the scored fallback matcher; exact key matching stays on.
EVENTPULSE_DEDUP_ENABLED=true

# Comma-separated emails allowed into the admin area, Horizon and Log Viewer.
EVENTPULSE_ADMIN_EMAILS=

# Log channel artisan commands mirror their terminal output to.
# Leave empty to use the default LOG_CHANNEL.
EVENTPULSE_CONSOLE_LOG_CHANNEL=

# Log Viewer (opcodesio/log-viewer) — UI at /log-viewer, admin-only in every env.
LOG_VIEWER_ENABLED=true

# Web push notifications. PushSender silently no-ops when disabled or when the
# VAPID keys are missing, so an unset key here looks like "no pushes", not an
# error. Generate a pair with:
#   php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
WEBPUSH_ENABLED=false
WEBPUSH_VAPID_SUBJECT="mailto:events@ghes.app"
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"

EVENTBRITE_API_KEY=
SERPAPI_API_KEY=
APIFY_API_TOKEN=
APIFY_DAILY_BUDGET_USD=

SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=ghes_
