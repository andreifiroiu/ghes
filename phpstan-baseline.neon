parameters:
	ignoreErrors:
		-
			message: '#^Offset ''adapter'' on array\{adapter\: string, url\: string, enabled\: bool, interval_hours\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Jobs/RunScraperJob.php

		-
			message: '#^Method App\\Services\\Chat\\OnboardingAgent\:\:buildApiMessages\(\) has parameter \$history with generic class Illuminate\\Database\\Eloquent\\Collection but does not specify its types\: TKey, TModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Services/Chat/OnboardingAgent.php

		-
			message: '#^Method App\\Services\\Chat\\OnboardingAgent\:\:formatConversation\(\) has parameter \$messages with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/Chat/OnboardingAgent.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection\<\(int\|string\),Illuminate\\Database\\Eloquent\\Model\>\:\:map\(\) expects callable\(Illuminate\\Database\\Eloquent\\Model, int\|string\)\: array\{role\: string, content\: string\}, Closure\(App\\Models\\ChatMessage\)\: array\{role\: string, content\: string\} given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/Chat/OnboardingAgent.php
